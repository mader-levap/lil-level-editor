<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyTitle>Lost in Limbo: level generator/editor</AssemblyTitle>
    <Product>Lost in Limbo: level generator/editor</Product>
    <Company>Mader Levap</Company>
    <InformationalVersion>0.1.0</InformationalVersion>
    <Description>Editor for Lost in Limbo.</Description>

    <!-- windows7.0 required: Gum.Stride's Direct3D Skia backends (D3D11, D3D12) are only available on this TFM.
         The graphics API itself (Direct3D 12) is set in the root Directory.Build.props. -->
    <TargetFramework>net10.0-windows7.0</TargetFramework>
    <Nullable>enable</Nullable>
    <RootNamespace>LostInLimbo.LevelEditor</RootNamespace>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="BuildType" Value="$(Configuration)" />

    <!-- Preview on purpose: the newest stable Gum.Stride (2026.11.2.1) supports only Direct3D 11, which crashes.
         Move to a stable release once one supports Direct3D 12. -->
    <PackageReference Include="Gum.Stride" Version="2026.11.13.2-preview.7" />
    <PackageReference Include="LostInLimbo.LevelGen" Version="0.0.9" />
    <PackageReference Include="Stride.Engine" Version="4.4.2" />
    <PackageReference Include="Stride.Video" Version="4.4.2" />
    <PackageReference Include="Stride.Physics" Version="4.4.2" />
    <PackageReference Include="Stride.Navigation" Version="4.4.2" />
    <PackageReference Include="Stride.Particles" Version="4.4.2" />
    <PackageReference Include="Stride.AssetCompiler" Version="4.4.2" IncludeAssets="build;buildTransitive" />
  </ItemGroup>

  <ItemGroup>
    <!-- Gum loads images as plain files (not via Stride content); see Ui/Gum/Common/GumIcons.cs.
         Copies all icons, including subfolders, to GumContent/Icons/ keeping the folder structure.
         Remove + Include (not Update): %(RecursiveDir) is only relative to Icons/ for items created
         by this glob; the SDK's default None items would give the full path from the project root. -->
    <None Remove="Resources\Graphics\Icons\**" />
    <None Include="Resources\Graphics\Icons\**\*.png" Link="GumContent\Icons\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />

    <!-- Theme fonts (Inter + its OFL license), loaded by Ui/Gum/Theme/EditorTheme.cs. Same pattern as icons. -->
    <None Remove="Resources\Fonts\**" />
    <None Include="Resources\Fonts\**\*.*" Link="GumContent\Fonts\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
